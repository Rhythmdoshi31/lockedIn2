CONTEXT_KEY=
GEMINI_KEY=
# Optional server-side model overrides (comma-separate multiple fallbacks).
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite

# Supabase (publishable values may be used by the browser; secret key is server-only).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Dodo Payments (all server-only).
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_PAYMENTS_STARTER_PRODUCT_ID=
DODO_PAYMENTS_PREMIUM_PRODUCT_ID=
DODO_PAYMENTS_WEBHOOK_KEY=
